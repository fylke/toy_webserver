# Copy this file to .env for local use.
# The compose stack reads these values automatically.

# Required for classroom access. Rotate this token between sessions.
CLASS_SHARED_TOKEN=replace-this-before-class

# Optional: keep fixed ports for a real class.
HOST_TCP_PORT=7777
HOST_HTTP_PORT=8080
HOST_PROXY_PORT=8081

# Optional: override if your container runtime needs a different proxy route.
PROXY_UPSTREAM=host.containers.internal:8080

# Optional: enable random host ports for local validation runs.
# RANDOMIZE_PORTS=1
